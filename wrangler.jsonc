{
  // 仅使用 D1。部署脚本先确认数据库 ID，再迁移与发布，无需开通 R2。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vodplus-sync",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "vodplus-sync", "migrations_dir": "migrations","database_id": "dc08f850-e419-4f07-89c1-2dde88dc32e7" }],
  "observability": { "enabled": false },
  "triggers": { "crons": ["17 3 * * *"] }
}
